          "Opal alternative with a lifetime option",
          "one sec alternative with real friction",
          "ScreenZen alternative with movement",
          "Jomo alternative lifetime",
          "Forest app alternative for social media",
          "Brick alternative no hardware",
          "Unpluq alternative no NFC tag",
          "screen time app with a free tier",
          "lifetime app blocker iPhone",
          "app blocker that shows the steps left to unlock",
          "app blocker that counts Apple Watch steps from Apple Health",
          "block TikTok until step goal",
