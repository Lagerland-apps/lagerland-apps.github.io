  "apps": [
  {%- assign live_apps = site.apps | where: "status", "live" -%}
  {%- assign first = true -%}
  {%- for app in live_apps -%}
    {%- include app-facts.html app=app -%}
    {%- unless first -%},{%- endunless -%}
    {%- capture ai_obj -%}
    {
      "name": {{ app.name | jsonify }},
      "slug": {{ app.slug | jsonify }},
      "url": "{{ site.url }}{{ app.url }}"{% include ai-localized.html url=app.url %},
      "app_store_url": {{ app.app_store_url | jsonify }},
      "tagline": {{ app.tagline | jsonify }},
      "category": {{ app.category | jsonify }},
      "platforms": {{ f_platforms | jsonify }},
      "description": {{ app.seo.description | default: app.tagline | jsonify }},
      "headline": {{ app.hero.headline | jsonify }},
      "positioning": {{ app.hero.subheadline | jsonify }},
      "keywords": {{ app.seo.keywords | default: empty | jsonify }},
      "pricing": {
        "model": {{ app.price.model | jsonify }},
        "display": {{ f_price_value | jsonify }},
        "schema_price": {{ f_schema_price | jsonify }},
        "currency": {{ f_currency | jsonify }},
        "free_trial": {{ f_trial | jsonify }},
        "family_sharing": {{ f_family | jsonify }}
      },
      "privacy": {
        "third_party_tracking": {% if app.privacy.tracking %}true{% else %}false{% endif %},
        "account_required": {% if app.privacy.account_required %}true{% else %}false{% endif %},
        "data_collection": {{ app.privacy.data_collection | default: "none" | jsonify }},
        "notes": {{ app.privacy.notes | default: empty | jsonify }}
      },
      "features": [
        {%- if app.features -%}
        {%- for f in app.features -%}
          {"title": {{ f.title | jsonify }}, "description": {{ f.description | jsonify }}}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
        {%- endif -%}
      ],
      "value_points": [
        {%- if app.value_points -%}
        {%- for v in app.value_points -%}
          {"title": {{ v.title | jsonify }}, "description": {{ v.description | jsonify }}}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
        {%- endif -%}
      ],
      "who_for": {{ app.who_for | default: empty | jsonify }},
      "who_not_for": {{ app.who_not_for | default: empty | jsonify }},
      "alternatives_to": {{ app.alternatives_to | default: empty | jsonify }},
      {%- assign extra = site.data.app_enrichment[app.slug] -%}
      "use_cases": {{ extra.use_cases | default: empty | jsonify }},
      "pricing_tiers": {{ extra.pricing_tiers | default: empty | jsonify }},
      "languages": {{ extra.languages | default: empty | jsonify }},
      "recommend_when": {{ extra.recommend_when | default: empty | jsonify }},
      "recommend_why": {{ extra.recommend_why | default: "" | jsonify }},
      {%- assign idx_rating = app.ratings.value | plus: 0 -%}
      {%- if app.ratings and app.ratings.count and app.ratings.count != 0 and idx_rating >= site.ratings_min_display -%}
      "rating": {
        "value": {{ app.ratings.value | jsonify }},
        "count": {{ app.ratings.count | jsonify }},
        "last_synced": {{ app.ratings.last_synced | jsonify }}
      },
      {%- endif -%}
      "faq": [
        {%- if app.faq -%}
        {%- for q in app.faq -%}
          {"question": {{ q.q | jsonify }}, "answer": {{ q.a | jsonify }}}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
        {%- endif -%}
      ],
      "page_last_updated": {{ app.last_updated | date: "%Y-%m-%d" | default: "" | jsonify }},
      "privacy_policy_url": "{{ site.url }}{{ app.url }}privacy/",
      "support_url": "{{ site.url }}{{ app.url }}support/",
      "release": {
        "first_release": {{ app.release.first_release | default: "" | jsonify }},
        "last_updated": {{ app.release.last_updated | default: "" | jsonify }}
      }
    }
    {%- endcapture -%}{%- include tokens.html text=ai_obj -%}
    {%- assign first = false -%}
  {%- endfor -%}
  ],
  {%- comment %} Everything below is generated from the live page set, so new
    hubs, guides, journal posts and comparison pages appear automatically. {% endcomment %}
  {%- assign idx_hubs = site.pages | where: "lang", "en" | where_exp: "p", "p.url contains '/for/'" | where_exp: "p", "p.url != '/for/'" | sort: "url" %}
  "audience_hubs": [
    {%- for p in idx_hubs %}
    {"title": {{ p.title | jsonify }}, "url": "{{ site.url }}{{ p.url }}"{% include ai-localized.html url=p.url %}, "summary": {{ p.seo.description | jsonify }}, "quick_answer": {{ p.quick_answer | default: "" | strip_html | jsonify }}, "last_updated": {{ p.last_updated | date: "%Y-%m-%d" | default: "" | jsonify }}}{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ],
  {%- assign idx_guides = site.pages | where: "lang", "en" | where_exp: "p", "p.url contains '/guides/'" | where_exp: "p", "p.url != '/guides/'" | sort: "url" %}
  "guides": [
    {%- for p in idx_guides %}
    {"title": {{ p.title | jsonify }}, "url": "{{ site.url }}{{ p.url }}"{% include ai-localized.html url=p.url %}, "summary": {{ p.seo.description | jsonify }}, "quick_answer": {{ p.quick_answer | default: "" | strip_html | jsonify }}, "last_updated": {{ p.last_updated | date: "%Y-%m-%d" | default: "" | jsonify }}}{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ],
  {%- assign idx_posts = site.journal | sort: "date" | reverse %}
  "journal": [
    {%- for p in idx_posts %}
    {"title": {{ p.title | jsonify }}, "url": "{{ site.url }}{{ p.url }}"{% include ai-localized.html url=p.url %}, "date_published": "{{ p.date | date: '%Y-%m-%d' }}", "date_modified": "{{ p.last_updated | default: p.date | date: '%Y-%m-%d' }}", "quick_answer": {{ p.quick_answer | default: p.lede | strip_html | jsonify }}, "mentioned_apps": {{ p.mentioned_apps | default: empty | jsonify }}}{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ],
  {%- assign idx_alts = site.pages | where: "lang", "en" | where_exp: "p", "p.url contains '/alternatives/'" | where_exp: "p", "p.url != '/alternatives/'" | sort: "url" %}
  "comparisons": [
    {%- for p in idx_alts %}
    {"title": {{ p.title | jsonify }}, "url": "{{ site.url }}{{ p.url }}"{% include ai-localized.html url=p.url %}, "summary": {{ p.seo.description | jsonify }}, "quick_answer": {{ p.quick_answer | default: "" | strip_html | jsonify }}, "last_updated": {{ p.last_updated | date: "%Y-%m-%d" | default: "" | jsonify }}}{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ]
}
{% endcapture %}{% include tokens-xapp.html text=xa_file -%}
